---
import { getCollection, render } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

// Approximate reading time
const wordCount = (post.body || '').split(/\s+/).length;
const readTime = Math.max(1, Math.ceil(wordCount / 200));

// Formatted date
const formattedDate = new Intl.DateTimeFormat('es-AR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
}).format(post.data.pubDate);

const articleDate = post.data.pubDate.toISOString();
const articleModifiedDate = (post.data.updatedDate || post.data.pubDate).toISOString();

// Filter table of contents for h2 and h3
const toc = headings.filter(h => h.depth === 2 || h.depth === 3);

const articleSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      '@id': `https://daractivosdigitales.com.ar/blog/${post.id}#article`,
      headline: post.data.title,
      description: post.data.description,
      datePublished: articleDate,
      dateModified: articleModifiedDate,
      author: {
        '@type': 'Person',
        name: 'Ing. David Ariel Raskovsky'
      },
      publisher: {
        '@type': 'Organization',
        name: 'DAR Activos Digitales',
        url: 'https://daractivosdigitales.com.ar',
        logo: {
          '@type': 'ImageObject',
          url: 'https://daractivosdigitales.com.ar/assets/logo.svg'
        }
      },
      image: new URL(post.data.heroImage || '/img/og-default.png', Astro.site).toString(),
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': `https://daractivosdigitales.com.ar/blog/${post.id}`
      }
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `https://daractivosdigitales.com.ar/blog/${post.id}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Inicio',
          item: 'https://daractivosdigitales.com.ar'
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Blog',
          item: 'https://daractivosdigitales.com.ar/blog'
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: post.data.title,
          item: `https://daractivosdigitales.com.ar/blog/${post.id}`
        }
      ]
    }
  ]
};
---

<BlogLayout
  title={post.data.title}
  description={post.data.description}
  articleDate={articleDate}
  articleModifiedDate={articleModifiedDate}
  tags={post.data.tags}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />
  <div style="max-width: 1200px; margin: 0 auto; padding: 40px 24px 80px 24px;">
    <!-- Breadcrumbs -->
    <nav aria-label="Miga de pan" style="display: flex; align-items: center; gap: 8px; font-size: 13px; color: #64748B; margin-bottom: 24px;">
      <a href="/" style="color: #64748B;">Inicio</a>
      <span>/</span>
      <a href="/blog" style="color: #64748B;">Blog</a>
      <span>/</span>
      <span style="color: #2453FF; font-weight: 600;">{post.data.category}</span>
    </nav>

    <!-- Post Header -->
    <header style="margin-bottom: 36px; max-width: 860px;">
      <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-bottom: 16px;">
        <span style="background: #EFF6FF; color: #1E40AF; font-size: 13px; font-weight: 700; padding: 4px 12px; border-radius: 6px;">
          {post.data.category}
        </span>
        <span style="color: #64748B; font-size: 14px; display: inline-flex; align-items: center; gap: 4px;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          {readTime} min de lectura
        </span>
      </div>

      <h1 style="font-size: clamp(2.2rem, 4.5vw, 3.1rem); font-weight: 800; color: #0F172A; line-height: 1.2; letter-spacing: -0.03em; margin-bottom: 20px;">
        {post.data.title}
      </h1>

      <p style="font-size: 1.22rem; color: #475569; line-height: 1.6; margin-bottom: 24px;">
        {post.data.description}
      </p>

      <!-- Author and Meta -->
      <div style="display: flex; align-items: center; gap: 14px; padding-top: 16px; border-top: 1px solid #E2E8F0;">
        <div style="width: 44px; height: 44px; border-radius: 50%; background: #0B0D3A; color: #FFFFFF; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 15px; border: 2px solid #2453FF;">
          DR
        </div>
        <div>
          <div style="font-weight: 700; font-size: 15px; color: #0F172A;">Ing. David Ariel Raskovsky</div>
          <div style="font-size: 13px; color: #64748B;">
            Publicado el <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
          </div>
        </div>
      </div>
    </header>

    <!-- Content Grid (Article + Sidebar ToC) -->
    <div style="display: grid; grid-template-columns: 1fr; gap: 48px; align-items: start;" class="article-layout">
      <!-- Main Prose Column -->
      <article class="prose" style="max-width: 820px; width: 100%;">
        {post.data.resumen && (
          <div class="resumen-box" style="background: #EFF6FF; border-left: 4px solid #2453FF; border-radius: 0 12px 12px 0; padding: 20px 24px; margin-bottom: 32px;">
            <div style="display: flex; align-items: center; gap: 8px; font-weight: 700; font-size: 14px; color: #1E40AF; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2453FF" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10" />
                <line x1="12" y1="16" x2="12" y2="12" />
                <line x1="12" y1="8" x2="12.01" y2="8" />
              </svg>
              En resumen
            </div>
            <p style="font-size: 1.05rem; line-height: 1.65; color: #1E3A8A; margin: 0; font-weight: 500;">
              {post.data.resumen}
            </p>
          </div>
        )}

        <Content />

        <!-- Article Tags -->
        <div style="margin-top: 48px; padding-top: 24px; border-top: 1px solid #E2E8F0; display: flex; flex-wrap: wrap; align-items: center; gap: 8px;">
          <strong style="font-size: 14px; color: #0F172A; margin-right: 4px;">Etiquetas:</strong>
          {post.data.tags.map((tag: string) => (
            <a href={`/blog?tag=${tag}`} style="font-size: 13px; font-weight: 500; background: #F1F5F9; color: #475569; padding: 4px 12px; border-radius: 20px; text-decoration: none; border: 1px solid #E2E8F0;">
              #{tag}
            </a>
          ))}
        </div>

        <!-- Author Bio Card -->
        <div style="margin-top: 40px; background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 16px; padding: 28px; display: flex; gap: 20px; align-items: center;">
          <div style="width: 56px; height: 56px; border-radius: 50%; background: #0B0D3A; color: #FFFFFF; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 18px; flex-shrink: 0; border: 2px solid #2453FF;">
            DR
          </div>
          <div>
            <h4 style="margin: 0 0 6px 0; font-size: 1.1rem; color: #0F172A;">Sobre el Autor</h4>
            <p style="margin: 0; font-size: 0.95rem; color: #475569; line-height: 1.5;">
              <strong>Ing. David Ariel Raskovsky</strong> — Especialista en arquitectura de software, sistemas distribuidos de alta concurrencia y modernización de plataformas empresariales en DAR Activos Digitales.
            </p>
          </div>
        </div>

        <!-- Back to blog navigation -->
        <div style="margin-top: 40px;">
          <a href="/blog" style="display: inline-flex; align-items: center; gap: 8px; font-weight: 700; font-size: 15px; color: #2453FF;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
            Volver al índice del blog
          </a>
        </div>
      </article>

      <!-- Sidebar Table of Contents -->
      {toc.length > 0 && (
        <aside class="toc-sidebar" style="position: sticky; top: 90px; background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 16px; padding: 24px; box-shadow: 0 2px 10px rgba(15, 23, 42, 0.03);">
          <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 16px; font-weight: 700; font-size: 14px; color: #0F172A; text-transform: uppercase; letter-spacing: 0.05em;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2453FF" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="21" y1="10" x2="3" y2="10"/><line x1="21" y1="6" x2="3" y2="6"/><line x1="21" y1="14" x2="3" y2="14"/><line x1="21" y1="18" x2="3" y2="18"/></svg>
            En este artículo
          </div>
          <nav aria-label="Tabla de contenidos">
            <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; font-size: 13.5px;">
              {toc.map((heading) => (
                <li style={{ paddingLeft: heading.depth === 3 ? '14px' : '0' }}>
                  <a
                    href={`#${heading.slug}`}
                    class="toc-link"
                    style="color: #64748B; text-decoration: none; display: block; line-height: 1.4; transition: color 0.2s;"
                    onmouseover="this.style.color='#2453FF'"
                    onmouseout="this.style.color='#64748B'"
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )}
    </div>
  </div>

  <style>
    @media (min-width: 1080px) {
      .article-layout {
        grid-template-columns: minmax(0, 1fr) 280px !important;
      }
    }
    @media (max-width: 1079px) {
      .toc-sidebar {
        display: none !important;
      }
    }
  </style>
</BlogLayout>

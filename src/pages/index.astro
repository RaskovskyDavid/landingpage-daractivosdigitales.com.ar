  })
  .then(async (res) => {
    let json = await res.json();
    if (res.status === 200) {
      statusMsg.style.display = 'block';
      statusMsg.style.color = '#0E7C66';
      statusMsg.style.fontWeight = '600';
      statusMsg.textContent = '¡Listo! Recibimos tu consulta. Te respondemos en menos de un día hábil.';
      submitBtn.textContent = 'Solicitud enviada ✓';
      submitBtn.style.background = '#0E7C66';
      document.getElementById('contactForm').reset();
    } else {
      statusMsg.style.display = 'block';
      statusMsg.style.color = '#C92A2A';
      statusMsg.textContent = 'Hubo un error al enviar. Por favor escribinos por WhatsApp.';
      submitBtn.disabled = false;
      submitBtn.textContent = 'Solicitá tu app';
    }
  })
  .catch((err) => {
    statusMsg.style.display = 'block';
    statusMsg.style.color = '#C92A2A';
    statusMsg.textContent = 'Error de conexión. Por favor escribinos directamente por WhatsApp.';
    submitBtn.disabled = false;
    submitBtn.textContent = 'Solicitá tu app';
  });
}
</script>

<!-- ============ MODAL DE CONTACTO / AGENDAR CONSULTA ============ -->
<div id="contactModal" aria-hidden="true" role="dialog" aria-modal="true" style="display: none; position: fixed; inset: 0; z-index: 1000; background: rgba(14,23,38,.75); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); align-items: center; justify-content: center; padding: 20px; box-sizing: border-box; opacity: 0; transition: opacity .25s ease">
  <div style="background: #FFFFFF; border-radius: 24px; max-width: 600px; width: 100%; max-height: 90vh; overflow-y: auto; padding: 36px 32px; box-shadow: 0 24px 64px rgba(0,0,0,.3); position: relative; display: flex; flex-direction: column; gap: 20px; box-sizing: border-box">
    
    <!-- Botón Cerrar -->
    <button type="button" onclick="closeContactModal()" aria-label="Cerrar modal" style="position: absolute; top: 20px; right: 20px; width: 36px; height: 36px; border-radius: 50%; border: 0; background: #F1F4F9; color: #0E1726; font-size: 20px; font-weight: 600; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: background .2s">
      &times;
    </button>

    <div>
      <p style="font-size: 12px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #2453FF; margin-bottom: 6px">DAR Activos Digitales</p>
      <h3 id="modalTitle" style="font-size: 26px; font-weight: 700; color: #0E1726; line-height: 1.25; margin: 0">Agendar consulta / Solicitá tu app</h3>
      <p style="font-size: 15px; color: #3B4A63; line-height: 1.5; margin-top: 8px">Contanos en qué podemos ayudarte. Te responderemos en menos de 24 horas hábiles.</p>
    </div>

    <!-- Formulario dentro del modal -->
    <form id="modalContactForm" onsubmit="handleModalFormSubmit(event)" style="display: flex; flex-direction: column; gap: 16px">
      <div style="display: flex; flex-wrap: wrap; gap: 14px">
        <label style="flex: 1 1 200px; display: flex; flex-direction: column; gap: 6px; font-size: 14px; font-weight: 600; color: #0E1726">
          ¿Cómo te llamás?
          <input type="text" id="modalNombre" name="nombre" placeholder="Tu nombre" required style="min-height: 44px; border-radius: 8px; border: 1px solid #C9D2DE; background: #FFFFFF; color: #0E1726; padding: 0 14px; font: inherit; font-size: 15px">
        </label>
        <label style="flex: 1 1 200px; display: flex; flex-direction: column; gap: 6px; font-size: 14px; font-weight: 600; color: #0E1726">
          ¿Cuál es tu empresa?
          <input type="text" id="modalEmpresa" name="empresa" placeholder="Empresa o proyecto" style="min-height: 44px; border-radius: 8px; border: 1px solid #C9D2DE; background: #FFFFFF; color: #0E1726; padding: 0 14px; font: inherit; font-size: 15px">
        </label>
      </div>

      <label style="display: flex; flex-direction: column; gap: 6px; font-size: 14px; font-weight: 600; color: #0E1726">
        ¿Qué necesitás resolver?
        <textarea id="modalProblema" name="problema" rows="3" required placeholder="Ej: Quiero una tienda online / un chatbot para WhatsApp / una app interna..." style="border-radius: 8px; border: 1px solid #C9D2DE; background: #FFFFFF; color: #0E1726; padding: 10px 14px; font: inherit; font-size: 15px; resize: vertical"></textarea>
      </label>

      <fieldset style="border: 0; margin: 0; padding: 0">
        <legend style="font-size: 14px; font-weight: 600; color: #0E1726; padding: 0; margin-bottom: 8px">Presupuesto o tipo de solución:</legend>
        <div style="display: flex; flex-wrap: wrap; gap: 6px" id="modalBudgetContainer">
          <button type="button" class="modal-pill" onclick="selectModalBudget(0, this)" style="min-height: 38px; padding: 0 14px; border-radius: 999px; border: 1px solid #D5DDE8; background: #FFFFFF; color: #142F99; font: inherit; font-size: 13px; font-weight: 600; cursor: pointer; transition: all .2s">Landing simple (~USD 160)</button>
          <button type="button" class="modal-pill" onclick="selectModalBudget(1, this)" style="min-height: 38px; padding: 0 14px; border-radius: 999px; border: 1px solid #D5DDE8; background: #FFFFFF; color: #142F99; font: inherit; font-size: 13px; font-weight: 600; cursor: pointer; transition: all .2s">Web corporativa (~USD 260)</button>
          <button type="button" class="modal-pill" onclick="selectModalBudget(2, this)" style="min-height: 38px; padding: 0 14px; border-radius: 999px; border: 1px solid #D5DDE8; background: #FFFFFF; color: #142F99; font: inherit; font-size: 13px; font-weight: 600; cursor: pointer; transition: all .2s">E-commerce (~USD 450)</button>
          <button type="button" class="modal-pill" onclick="selectModalBudget(3, this)" style="min-height: 38px; padding: 0 14px; border-radius: 999px; border: 1px solid #D5DDE8; background: #FFFFFF; color: #142F99; font: inherit; font-size: 13px; font-weight: 600; cursor: pointer; transition: all .2s">Chatbot (~USD 500 + abono)</button>
          <button type="button" class="modal-pill" onclick="selectModalBudget(4, this)" style="min-height: 38px; padding: 0 14px; border-radius: 999px; border: 1px solid #D5DDE8; background: #FFFFFF; color: #142F99; font: inherit; font-size: 13px; font-weight: 600; cursor: pointer; transition: all .2s">Agente transacciones (~USD 3.500 + abono)</button>
          <button type="button" class="modal-pill" onclick="selectModalBudget(5, this)" style="min-height: 38px; padding: 0 14px; border-radius: 999px; border: 1px solid #D5DDE8; background: #FFFFFF; color: #142F99; font: inherit; font-size: 13px; font-weight: 600; cursor: pointer; transition: all .2s">A convenir / Todavía no sé</button>
        </div>
      </fieldset>

      <label style="display: flex; flex-direction: column; gap: 6px; font-size: 14px; font-weight: 600; color: #0E1726">
        ¿Dónde te respondo?
        <input type="text" id="modalContacto" name="contacto" placeholder="Email o WhatsApp con código de área" required style="min-height: 44px; border-radius: 8px; border: 1px solid #C9D2DE; background: #FFFFFF; color: #0E1726; padding: 0 14px; font: inherit; font-size: 15px">
      </label>

      <button type="submit" id="modalSubmitBtn" class="btn" style="min-height: 48px; border: 0; border-radius: 8px; background: #2453FF; color: #FFFFFF; padding: 0 24px; font: inherit; font-weight: 600; font-size: 16px; cursor: pointer; transition: background .2s">Enviar consulta</button>
      <div id="modalStatusMsg" style="font-size: 14px; display: none; line-height: 1.4"></div>
    </form>
  </div>
</div>

</body>
</html>

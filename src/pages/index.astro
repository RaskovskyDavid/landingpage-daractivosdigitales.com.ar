      sameAs: [
        'https://wa.me/5493815000000',
        'https://github.com/RaskovskyDavid',
        'https://www.linkedin.com'
      ],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Servicios de Desarrollo de Software',
        itemListElement: [
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',

---
<!doctype html>
<html lang="es">
<head>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="alternate icon" type="image/png" href="/favicon.png">
  <link rel="shortcut icon" href="/favicon.ico">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="canonical" href="https://daractivosdigitales.com.ar">
<title>DAR Activos Digitales — Software a medida, tu app funcionando</title>
<meta name="description" content="Una página web para que te encuentren, una app para tus clientes o tu equipo, una tienda digital que cobra sola o un chatbot que te ayuda a cerrar ventas mientras dormís. Estudio del Ing. David Ariel Raskovsky.">
<script type="application/ld+json" is:inline set:html={JSON.stringify(homeSchema)} />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap">
<style is:inline>
/* Reset & Base */
*, *::before, *::after { box-sizing: border-box; }
body {
  margin: 0;
  background: #F4FAFD;
  color: #17253D;
  font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
  -webkit-font-smoothing: antialiased;
  line-height: 1.5;
}
h1, h2, h3, p, ul, ol { margin: 0; }
a { color: #142F99; text-decoration: none; }
a:hover { color: #2453FF; }
button { font-family: inherit; }

/* Buttons & Links */
.btn { transition: background-color .2s, border-color .2s; }
.btn:hover { background-color: #1A3FCC !important; }
.btn-soft:hover { background-color: #D4DEFF !important; }
.btn-line:hover { background-color: rgba(185,200,255,.14) !important; }

.alink {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  text-decoration: none;
  color: #142F99;
  font-weight: 600;
  font-size: 15px;
}
.alink:hover .sq { background: #1A3FCC; }
.sq {
  width: 36px;
  height: 36px;
  border-radius: 6px;
  background: #2453FF;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 36px;
  transition: background-color .2s;
}

/* Cards & Zooms */
.card {
  transition: transform .6s cubic-bezier(.2,.7,.2,1), box-shadow .6s;
}
.card:hover {
  transform: translateY(-6px);
  box-shadow: 0 0 2px rgba(0,0,0,.12), 0 18px 40px rgba(14,23,38,.12) !important;
}
.zoom { transition: transform .38s ease-out; }
.card:hover .zoom { transform: scale(1.04); }

.pill {
  transition: background-color .125s ease-in-out, color .125s ease-in-out;
}

/* Reveal on scroll */
.rv { transition: opacity 1.2s ease-in-out, transform 1.2s ease-in-out; }
.rvon .rv:not(.in) { opacity: 0; transform: translateY(28px); }

/* Neon Header Animations */
@keyframes draw { from { stroke-dashoffset: 1400; } to { stroke-dashoffset: 0; } }
@keyframes glow { 0%, 100% { opacity: 1; } 50% { opacity: .55; } }
.neon path {
  stroke-dasharray: 1400;
  animation: draw 2.4s cubic-bezier(.2,.7,.2,1) both, glow 7s ease-in-out 2.6s infinite;
}
.neon path:nth-child(2) { animation-delay: .25s, 2.9s; }
.neon path:nth-child(3) { animation-delay: .5s, 3.2s; }
.neon path:nth-child(4) { animation-delay: .75s, 3.5s; }
.paused * { animation-play-state: paused !important; }

@keyframes drift { to { background-position: 240px 120px; } }
.texture { animation: drift 30s linear infinite; }
.subnav::-webkit-scrollbar, .pills::-webkit-scrollbar { display: none; }

@media (prefers-reduced-motion: reduce) {
  .rvon .rv:not(.in) { transform: none; }
  .rv { transition: opacity .6s; }
  .neon path, .texture { animation: none !important; stroke-dasharray: none; }
  .card, .zoom { transition: none; }
}

@media (max-width: 768px) {
  .header-links .nav-desktop { display: none !important; }
}


/* Grid de Logos - Estilo Microsoft (2 Filas de Tarjetas) */
.logo-grid-container {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 16px;
  width: 100%;
}

@media (max-width: 1024px) {
  .logo-grid-container {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media (max-width: 640px) {
  .logo-grid-container {
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }
}

.ms-logo-card {
  background: #FFFFFF;
  border: 1px solid #E2E8F0;
  border-radius: 20px;
  min-height: 105px;
  height: 105px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px 20px;
  box-shadow: 0 2px 8px rgba(14, 23, 38, 0.04);
  transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s ease, border-color 0.2s ease;
  box-sizing: border-box;
}

.ms-logo-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 10px 24px rgba(14, 23, 38, 0.08);
  border-color: #CBD5E1;
}

</style>
</head>
<body>
<div style="width: 100%; background: #F4FAFD; position: relative">

<!-- ============ HEADER ============ -->
<header style="background: #FFFFFF; border-bottom: 1px solid #E3E8EF">
  <nav aria-label="Principal" style="max-width: 1280px; margin: 0 auto; padding: 0 32px; min-height: 56px; display: flex; flex-wrap: wrap; align-items: center; gap: 12px 28px">
    <a href="/" style="display: flex; align-items: center; gap: 12px; text-decoration: none; color: #0E1726">
      <span aria-hidden="true" style="width: 34px; height: 34px; display: inline-flex; align-items: center; justify-content: center">
        <svg viewBox="0 0 36 36" width="34" height="34" fill="none" style="display: block">
          <rect width="36" height="36" rx="9" fill="#0B0D3A"/>
          <rect x="5" y="21" width="26" height="10" rx="3" fill="#141852" stroke="#2453FF" stroke-width="1.2"/>
          <line x1="8" y1="23.5" x2="28" y2="23.5" stroke="#3DF5A1" stroke-width="1.5" stroke-linecap="round"/>
          <circle cx="10" cy="27" r="1.5" fill="#3DF5A1"/>
          <circle cx="14" cy="27" r="1.5" fill="#22D3EE"/>
          <circle cx="18" cy="27" r="1.5" fill="#3DF5A1"/>
          <circle cx="22" cy="27" r="1.5" fill="#22D3EE"/>
          <circle cx="26" cy="27" r="1.5" fill="#3DF5A1"/>
          <path d="M9 7h14l4 4v12.5H9V7z" fill="#FFFFFF" fill-opacity="0.95" stroke="#CBD5E1" stroke-width="0.8"/>
          <rect x="11.5" y="10" width="1.8" height="1.2" rx="0.3" fill="#0B0D3A"/>
          <rect x="15" y="10" width="1.8" height="1.2" rx="0.3" fill="#0B0D3A"/>
          <rect x="20" y="10" width="1.8" height="1.2" rx="0.3" fill="#0B0D3A"/>
          <rect x="23.5" y="10" width="1.8" height="1.2" rx="0.3" fill="#0B0D3A"/>
          <rect x="13" y="13" width="1.8" height="1.2" rx="0.3" fill="#2453FF"/>
          <rect x="17" y="13" width="1.8" height="1.2" rx="0.3" fill="#2453FF"/>
          <rect x="22" y="13" width="1.8" height="1.2" rx="0.3" fill="#2453FF"/>
          <rect x="11.5" y="16" width="1.8" height="1.2" rx="0.3" fill="#0B0D3A"/>
          <rect x="15.5" y="16" width="1.8" height="1.2" rx="0.3" fill="#0B0D3A"/>
          <rect x="19" y="16" width="1.8" height="1.2" rx="0.3" fill="#0B0D3A"/>
          <rect x="23.5" y="16" width="1.8" height="1.2" rx="0.3" fill="#0B0D3A"/>
          <rect x="13.5" y="19" width="1.8" height="1.2" rx="0.3" fill="#14B8A6"/>
          <rect x="17.5" y="19" width="1.8" height="1.2" rx="0.3" fill="#14B8A6"/>
          <rect x="21.5" y="19" width="1.8" height="1.2" rx="0.3" fill="#14B8A6"/>
        </svg>
      </span>
      <span style="font-weight: 600; font-size: 17px">DAR</span>
      <span aria-hidden="true" style="width: 1px; height: 22px; background: #C9D2DE"></span>
      <span style="font-weight: 500; font-size: 16px">Activos Digitales</span>
    </a>
    <div class="header-links" style="display: flex; flex-wrap: wrap; align-items: center; gap: 8px 24px; font-size: 14px; margin-left: auto">
      <a href="#servicios" class="nav-desktop" style="color: #17253D; text-decoration: none">Servicios</a>
      <a href="#destacados" class="nav-desktop" style="color: #17253D; text-decoration: none">Casos</a>
      <a href="#como-trabajo" class="nav-desktop" style="color: #17253D; text-decoration: none">Cómo trabajo</a>
      <a href="/blog" style="color: #17253D; text-decoration: none">Blog</a>
      <a href="#contacto" class="nav-desktop" style="color: #17253D; text-decoration: none">Contacto</a>
      <a href="#contacto" onclick="openContactModal(event)" class="btn nav-desktop" style="background: #2453FF; color: #FFFFFF; text-decoration: none; padding: 0 16px; min-height: 36px; border-radius: 8px; font-weight: 600; display: inline-flex; align-items: center">Solicitá tu app</a>
      <a href="https://wa.me/5493815000000" target="_blank" rel="noopener" class="nav-desktop" style="border: 1px solid #0E1726; color: #0E1726; text-decoration: none; padding: 0 14px; min-height: 36px; border-radius: 8px; font-weight: 600; display: inline-flex; align-items: center">WhatsApp</a>
    </div>
  </nav>
</header>

<!-- ============ HERO ============ -->
<section aria-label="Presentación" style="background: #0B0D3A; color: #F4FAFD; position: relative; overflow: hidden">
  <div id="heroAnimWrap" aria-hidden="true" style="position: absolute; right: -40px; top: 0; bottom: 0; width: min(56%, 720px); pointer-events: none">
    <svg class="neon" viewBox="0 0 600 720" preserveAspectRatio="xMaxYMid slice" style="width: 100%; height: 100%; display: block">
      <defs>
        <filter id="nglow" x="-30%" y="-30%" width="160%" height="160%">
          <feGaussianBlur stdDeviation="6" result="b"/>
          <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
        </filter>
      </defs>
      <g filter="url(#nglow)" fill="none" stroke-linecap="round">
        <path d="M640 120 H420 Q330 120 330 210 V760" stroke="#6C7BFF" stroke-width="14"/>
        <path d="M640 180 H450 Q380 180 380 250 V760" stroke="#22D3EE" stroke-width="14"/>
        <path d="M640 240 H480 Q430 240 430 290 V760" stroke="#3DF5A1" stroke-width="14"/>
        <path d="M640 300 H510 Q480 300 480 330 V760" stroke="#FACC15" stroke-width="14"/>
      </g>
    </svg>
  </div>
  <button type="button" id="togglePauseBtn" onclick="toggleHeroPause()" aria-label="Pausar animación" style="position: absolute; top: 16px; left: 16px; width: 32px; height: 32px; border-radius: 8px; border: 0; background: #B9C8FF; color: #0B0D3A; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; z-index: 2">
    <svg id="pauseIcon" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><rect x="3" y="2" width="3" height="10" rx="1" fill="currentColor"/><rect x="8" y="2" width="3" height="10" rx="1" fill="currentColor"/></svg>
    <svg id="playIcon" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" style="display:none;"><path d="M3 2 L12 7 L3 12 Z" fill="currentColor"/></svg>
  </button>
  <div style="max-width: 1280px; margin: 0 auto; padding: 96px 32px 112px; position: relative; min-height: 560px; box-sizing: border-box; display: flex; align-items: center">
    <div style="max-width: 600px; display: flex; flex-direction: column; gap: 24px">
      <p class="rv" style="font-size: 13px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #B9C8FF">DAR Activos Digitales · Desarrollamos tu app</p>
      <h1 class="rv" style="font-size: clamp(32px, 3.6vw, 48px); line-height: 1.15; font-weight: 500; letter-spacing: -0.01em; color: #FFFFFF; transition-delay: .05s">Tu negocio vende y atiende, incluso a las 3 de la mañana.</h1>
      <p class="rv" style="font-size: 17px; line-height: 1.6; color: #D8DEF5; transition-delay: .1s">Una página web para que te encuentren, una app para tus clientes o tu equipo, una tienda digital que cobra sola o un chatbot que te ayuda a cerrar ventas mientras dormís. Nos contás el problema con tus palabras y lo convertimos en software que funciona. DAR Activos Digitales es el estudio del ingeniero David Ariel Raskovsky, con más de 10 años desarrollando sistemas para bancos e industria.</p>
      <div class="rv" style="display: flex; flex-wrap: wrap; gap: 12px; transition-delay: .15s">
        <a href="#contacto" class="btn-soft" style="background: #B9C8FF; color: #0B0D3A; text-decoration: none; padding: 0 20px; min-height: 48px; border-radius: 8px; font-weight: 600; font-size: 16px; display: inline-flex; align-items: center; transition: background-color .2s">Solicitá tu app</a>
        <a href="#servicios" class="btn-line" style="border: 2px solid #B9C8FF; color: #FFFFFF; text-decoration: none; padding: 0 20px; min-height: 48px; box-sizing: border-box; border-radius: 8px; font-weight: 600; font-size: 16px; display: inline-flex; align-items: center; transition: background-color .2s">Ver qué podemos hacer</a>
      </div>
    </div>
  </div>
</section>

<!-- ============ SUB-NAV STICKY ============ -->
<div style="position: sticky; top: 24px; z-index: 20; max-width: 1280px; margin: 24px auto 0; padding: 0 32px; box-sizing: border-box">
  <nav aria-label="En esta página" class="subnav" style="background: #FFFFFF; border-radius: 16px; box-shadow: 0 0 2px rgba(0,0,0,.12), 0 8px 24px rgba(14,23,38,.10); padding: 10px 12px 10px 24px; display: flex; align-items: center; gap: 8px; overflow-x: auto; scrollbar-width: none">
    <a href="#destacados" class="subnav-link" data-id="destacados" style="flex: 0 0 auto; padding: 10px 14px; text-decoration: none; font-size: 15px; font-weight: 600; white-space: nowrap; transition: color .3s, box-shadow .3s; color: #0E1726; box-shadow: inset 0 -3px 0 #2453FF">Destacados</a>
    <a href="#soluciones" class="subnav-link" data-id="soluciones" style="flex: 0 0 auto; padding: 10px 14px; text-decoration: none; font-size: 15px; font-weight: 600; white-space: nowrap; transition: color .3s, box-shadow .3s; color: #3B4A63; box-shadow: inset 0 -3px 0 transparent">Soluciones</a>
    <a href="#servicios" class="subnav-link" data-id="servicios" style="flex: 0 0 auto; padding: 10px 14px; text-decoration: none; font-size: 15px; font-weight: 600; white-space: nowrap; transition: color .3s, box-shadow .3s; color: #3B4A63; box-shadow: inset 0 -3px 0 transparent">Servicios</a>
    <a href="#como-trabajo" class="subnav-link" data-id="como-trabajo" style="flex: 0 0 auto; padding: 10px 14px; text-decoration: none; font-size: 15px; font-weight: 600; white-space: nowrap; transition: color .3s, box-shadow .3s; color: #3B4A63; box-shadow: inset 0 -3px 0 transparent">Cómo trabajo</a>
    <a href="#trayectoria" class="subnav-link" data-id="trayectoria" style="flex: 0 0 auto; padding: 10px 14px; text-decoration: none; font-size: 15px; font-weight: 600; white-space: nowrap; transition: color .3s, box-shadow .3s; color: #3B4A63; box-shadow: inset 0 -3px 0 transparent">Trayectoria</a>
    <a href="#contacto" onclick="openContactModal(event)" class="btn" style="margin-left: auto; flex: 0 0 auto; background: #2453FF; color: #FFFFFF; text-decoration: none; padding: 0 16px; min-height: 40px; border-radius: 8px; font-weight: 600; font-size: 15px; display: inline-flex; align-items: center">Solicitá tu app</a>
  </nav>
</div>

<!-- ============ DESTACADOS ============ -->

function handleModalFormSubmit(e) {
  e.preventDefault();
  const nombre = document.getElementById('modalNombre').value.trim();
  const empresa = document.getElementById('modalEmpresa').value.trim();
  const problema = document.getElementById('modalProblema').value.trim();
  const contacto = document.getElementById('modalContacto').value.trim();
  const submitBtn = document.getElementById('modalSubmitBtn');
  const statusMsg = document.getElementById('modalStatusMsg');

  if (!nombre || !problema || !contacto) {
    alert('Por favor completa tu nombre, el problema que querés resolver y tu contacto.');
    return;
  }

  submitBtn.disabled = true;
  submitBtn.textContent = 'Enviando...';

  const payload = {
    access_key: "ea13e0f9-daa7-4f26-9769-d4ad6d3ba265",
    name: nombre,
    email: contacto.includes('@') ? contacto : "contacto@daractivosdigitales.com.ar",
    phone: contacto,
    message: `Empresa: ${empresa || 'No indicada'}\nPresupuesto/Interés: ${modalSelectedBudgetLabel || 'No seleccionado'}\nDetalle: ${problema}`,
    subject: "Nueva consulta desde DAR Activos Digitales (Modal)",
    from_name: "DAR Activos Digitales"
  };

  fetch("https://api.web3forms.com/submit", {
    method: "POST",
    headers: { "Content-Type": "application/json", "Accept": "application/json" },
    body: JSON.stringify(payload)
  })
  .then(async (res) => {
    let json = await res.json();
    if (res.status === 200) {
      statusMsg.style.display = 'block';
      statusMsg.style.color = '#0E7C66';
      statusMsg.style.fontWeight = '600';
      statusMsg.textContent = '¡Listo! Recibimos tu consulta. Te respondemos en menos de un día hábil.';
      submitBtn.textContent = 'Consulta enviada ✓';
      submitBtn.style.background = '#0E7C66';
      document.getElementById('modalContactForm').reset();
      setTimeout(() => {
        closeContactModal();
      }, 2500);
    } else {
      statusMsg.style.display = 'block';
      statusMsg.style.color = '#C92A2A';
      statusMsg.textContent = 'Hubo un error al enviar. Por favor contactanos directamente por WhatsApp.';
      submitBtn.disabled = false;
      submitBtn.textContent = 'Enviar consulta';
    }
  })
  .catch((err) => {
    statusMsg.style.display = 'block';
    statusMsg.style.color = '#C92A2A';
    statusMsg.textContent = 'Error de conexión. Por favor escribinos por WhatsApp.';
    submitBtn.disabled = false;
    submitBtn.textContent = 'Enviar consulta';
  });
}


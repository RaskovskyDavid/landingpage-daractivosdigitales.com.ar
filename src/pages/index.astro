// Reveal on Scroll
document.addEventListener('DOMContentLoaded', () => {
  renderSolAccordion();
  renderRolePanel();

  document.documentElement.classList.add('rvon');
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('in');
        io.unobserve(e.target);
      }
    });
  }, { threshold: 0.15 });
  document.querySelectorAll('.rv').forEach(el => io.observe(el));

  // Scrollspy
  const subnavLinks = document.querySelectorAll('.subnav-link');
  const sections = ['destacados', 'soluciones', 'servicios', 'como-trabajo', 'trayectoria', 'contacto'];
  window.addEventListener('scroll', () => {
    const scrollPos = window.scrollY + 200;
    let currentId = 'destacados';
    sections.forEach(id => {
      const el = document.getElementById(id);
      if (el && scrollPos >= el.offsetTop) {
        currentId = id;
      }
    });
    subnavLinks.forEach(link => {
      if (link.getAttribute('data-id') === currentId) {
        link.style.color = '#0E1726';
        link.style.boxShadow = 'inset 0 -3px 0 #2453FF';
      } else {
        link.style.color = '#3B4A63';
        link.style.boxShadow = 'inset 0 -3px 0 transparent';
      }
    });
  });
});


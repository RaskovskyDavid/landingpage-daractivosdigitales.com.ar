---
interface Props {
  title: string;
  description: string;
  image?: string;
  articleDate?: string;
  articleModifiedDate?: string;
  tags?: string[];
}

const {
  title,
  description,
  image = '/img/og-default.png',
  articleDate,
  articleModifiedDate,
  tags = []
} = Astro.props;

const pathname = Astro.url.pathname.replace(/\.html$/, '').replace(/\/+$/, '') || '/';
const canonicalURL = new URL(pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate icon" type="image/png" href="/favicon.png" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="alternate" type="application/rss+xml" title="DAR Activos Digitales Blog RSS" href="/rss.xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="canonical" href={canonicalURL} />

  <!-- Primary Meta Tags -->
  <title>{title} — DAR Activos Digitales</title>
  <meta name="title" content={`${title} — DAR Activos Digitales`} />
  <meta name="description" content={description} />
  <meta name="author" content="Ing. David Ariel Raskovsky" />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content={articleDate ? "article" : "website"} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={`${title} — DAR Activos Digitales`} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={imageURL} />
  <meta property="og:site_name" content="DAR Activos Digitales" />
  {articleDate && <meta property="article:published_time" content={articleDate} />}
  {(articleModifiedDate || articleDate) && <meta property="article:modified_time" content={articleModifiedDate || articleDate} />}
  {tags.map((tag) => <meta property="article:tag" content={tag} />)}

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content={canonicalURL} />
  <meta property="twitter:title" content={`${title} — DAR Activos Digitales`} />
  <meta property="twitter:description" content={description} />
  <meta property="twitter:image" content={imageURL} />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" />

  <style is:global>
    *, *::before, *::after { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      background: #F4FAFD;
      color: #17253D;
      font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
      -webkit-font-smoothing: antialiased;
      line-height: 1.6;
    }
    a { color: #142F99; text-decoration: none; transition: color .2s; }
    a:hover { color: #2453FF; }

    /* Code & Syntax Highlighting */
    pre.astro-code {
      position: relative;
      padding: 1.25rem 1.25rem 1.25rem 1.25rem;
      border-radius: 12px;
      font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, monospace;
      font-size: 0.92rem;
      line-height: 1.65;
      margin: 1.75rem 0;
      border: 1px solid #1E293B;
      box-shadow: 0 4px 20px rgba(15, 23, 42, 0.15);
      overflow-x: auto;
    }
    
    code {
      font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, monospace;
      font-size: 0.9em;
    }

    :not(pre) > code {
      background: #E2E8F0;
      color: #0F172A;
      padding: 0.2rem 0.45rem;
      border-radius: 6px;
      font-size: 0.88em;
    }

    /* Copy Code Button */
    .copy-code-button {
      position: absolute;
      top: 0.65rem;
      right: 0.65rem;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(30, 41, 59, 0.8);
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 6px;
      padding: 5px 10px;
      font-size: 12px;
      font-weight: 500;
      color: #94A3B8;
      cursor: pointer;
      backdrop-filter: blur(4px);
      transition: all 0.2s ease;
      z-index: 10;
    }
    .copy-code-button:hover {
      background: #334155;
      color: #F8FAFC;
      border-color: rgba(255, 255, 255, 0.3);
    }
    .copy-code-button.copied {
      background: #059669;
      color: #FFFFFF;
      border-color: #10B981;
    }

    /* Blog Prose Typography */
    .prose {
      color: #334155;
      font-size: 1.08rem;
      line-height: 1.8;
    }
    .prose h1, .prose h2, .prose h3, .prose h4 {
      color: #0F172A;
      font-weight: 700;
      line-height: 1.3;
      margin-top: 2.2rem;
      margin-bottom: 0.85rem;
      scroll-margin-top: 5rem;
    }
    .prose h2 {
      font-size: 1.65rem;
      border-bottom: 1px solid #E2E8F0;
      padding-bottom: 0.4rem;
    }
    .prose h3 {
      font-size: 1.3rem;
    }
    .prose p {
      margin-top: 1rem;
      margin-bottom: 1.25rem;
    }
    .prose ul, .prose ol {
      margin: 1rem 0 1.25rem 1.5rem;
      padding: 0;
    }
    .prose li {
      margin-bottom: 0.5rem;
    }
    .prose blockquote {
      border-left: 4px solid #2453FF;
      background: #EFF6FF;
      padding: 1rem 1.5rem;
      margin: 1.75rem 0;
      border-radius: 0 8px 8px 0;
      color: #1E3A8A;
      font-style: italic;
    }
    .prose hr {
      border: 0;
      border-top: 1px solid #E2E8F0;
      margin: 2.5rem 0;
    }
    .prose table {
      width: 100%;
      border-collapse: collapse;
      margin: 1.75rem 0;
      font-size: 0.95rem;
    }
    .prose th, .prose td {
      border: 1px solid #E2E8F0;
      padding: 0.75rem 1rem;
      text-align: left;
    }
    .prose th {
      background: #F1F5F9;
      color: #0F172A;
      font-weight: 600;
    }
  </style>
</head>
<body>
  <!-- Header -->
  <header style="background: #FFFFFF; border-bottom: 1px solid #E3E8EF; position: sticky; top: 0; z-index: 50; backdrop-filter: blur(8px); background: rgba(255, 255, 255, 0.95);">
    <nav aria-label="Navegación Blog" style="max-width: 1200px; margin: 0 auto; padding: 0 24px; min-height: 60px; display: flex; align-items: center; justify-content: space-between; gap: 16px;">
      <a href="/" style="display: flex; align-items: center; gap: 12px; text-decoration: none; color: #0E1726;">
        <span aria-hidden="true" style="width: 34px; height: 34px; display: inline-flex; align-items: center; justify-content: center;">
          <svg viewBox="0 0 36 36" width="34" height="34" fill="none" style="display: block;">
            <rect width="36" height="36" rx="9" fill="#0B0D3A"/>
            <rect x="5" y="21" width="26" height="10" rx="3" fill="#141852" stroke="#2453FF" stroke-width="1.2"/>
            <line x1="8" y1="23.5" x2="28" y2="23.5" stroke="#3DF5A1" stroke-width="1.5" stroke-linecap="round"/>
            <circle cx="10" cy="27" r="1.5" fill="#3DF5A1"/>
            <circle cx="14" cy="27" r="1.5" fill="#22D3EE"/>
            <circle cx="18" cy="27" r="1.5" fill="#3DF5A1"/>
            <circle cx="22" cy="27" r="1.5" fill="#22D3EE"/>
            <circle cx="26" cy="27" r="1.5" fill="#3DF5A1"/>
            <path d="M9 7h14l4 4v12.5H9V7z" fill="#FFFFFF" fill-opacity="0.95" stroke="#CBD5E1" stroke-width="0.8"/>
            <rect x="11.5" y="10" width="1.8" height="1.2" rx="0.3" fill="#0B0D3A"/>
            <rect x="15" y="10" width="1.8" height="1.2" rx="0.3" fill="#0B0D3A"/>
            <rect x="20" y="10" width="1.8" height="1.2" rx="0.3" fill="#0B0D3A"/>
            <rect x="23.5" y="10" width="1.8" height="1.2" rx="0.3" fill="#0B0D3A"/>
            <rect x="13" y="13" width="1.8" height="1.2" rx="0.3" fill="#2453FF"/>
            <rect x="17" y="13" width="1.8" height="1.2" rx="0.3" fill="#2453FF"/>
            <rect x="22" y="13" width="1.8" height="1.2" rx="0.3" fill="#2453FF"/>
            <rect x="11.5" y="16" width="1.8" height="1.2" rx="0.3" fill="#0B0D3A"/>
            <rect x="15.5" y="16" width="1.8" height="1.2" rx="0.3" fill="#0B0D3A"/>
            <rect x="19" y="16" width="1.8" height="1.2" rx="0.3" fill="#0B0D3A"/>
            <rect x="23.5" y="16" width="1.8" height="1.2" rx="0.3" fill="#0B0D3A"/>
            <rect x="13.5" y="19" width="1.8" height="1.2" rx="0.3" fill="#14B8A6"/>
            <rect x="17.5" y="19" width="1.8" height="1.2" rx="0.3" fill="#14B8A6"/>
            <rect x="21.5" y="19" width="1.8" height="1.2" rx="0.3" fill="#14B8A6"/>
          </svg>
        </span>
        <span style="font-weight: 700; font-size: 17px; letter-spacing: -0.02em;">DAR</span>
        <span aria-hidden="true" style="width: 1px; height: 20px; background: #CBD5E1;"></span>
        <span style="font-weight: 600; font-size: 15px; color: #475569;">Activos Digitales</span>
      </a>

      <div style="display: flex; align-items: center; gap: 20px;">
        <a href="/" style="font-size: 14px; font-weight: 600; color: #475569;">Inicio</a>
        <a href="/blog" style="font-size: 14px; font-weight: 700; color: #2453FF;">Blog</a>
        <a href="/rss.xml" title="Feed RSS" style="display: inline-flex; align-items: center; gap: 5px; font-size: 13px; font-weight: 600; color: #EA580C; background: #FFF7ED; padding: 4px 10px; border-radius: 6px; border: 1px solid #FFEDD5;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
          RSS
        </a>
        <a href="/#contacto" style="background: #2453FF; color: #FFFFFF; padding: 8px 16px; border-radius: 8px; font-size: 14px; font-weight: 600; display: inline-flex; align-items: center; gap: 6px; transition: background-color .2s;">
          Contacto
        </a>
      </div>
    </nav>
  </header>

  <!-- Main Slot -->
  <main style="min-height: calc(100vh - 180px);">
    <slot />
  </main>

  <!-- Footer -->
  <footer style="background: #FFFFFF; border-top: 1px solid #E2E8F0; padding: 48px 24px; margin-top: 80px;">
    <div style="max-width: 1200px; margin: 0 auto; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 24px;">
      <div>
        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 8px;">
          <strong style="font-size: 16px; color: #0F172A;">DAR Activos Digitales</strong>
          <span style="font-size: 13px; color: #64748B;">• Ing. David Ariel Raskovsky</span>
        </div>
        <p style="font-size: 14px; color: #64748B; margin: 0;">Arquitectura de software para sistemas críticos, alto rendimiento y soluciones digitales escalables.</p>
      </div>
      <div style="display: flex; gap: 20px; font-size: 14px; font-weight: 500;">
        <a href="/" style="color: #64748B;">Inicio</a>
        <a href="/blog" style="color: #64748B;">Blog</a>
        <a href="/privacidad" style="color: #64748B;">Privacidad</a>
        <a href="/rss.xml" style="color: #64748B;">RSS</a>
      </div>
    </div>
  </footer>

  <!-- Script for Copy Code Button -->
  <script is:inline>
    function setupCodeCopyButtons() {
      const codeBlocks = document.querySelectorAll('pre.astro-code');
      codeBlocks.forEach((pre) => {
        if (pre.querySelector('.copy-code-button')) return;

        const button = document.createElement('button');
        button.className = 'copy-code-button';
        button.type = 'button';
        button.setAttribute('aria-label', 'Copiar código al portapapeles');
        button.innerHTML = `
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <span>Copiar</span>
        `;

        button.addEventListener('click', async () => {
          const code = pre.querySelector('code');
          const text = code ? code.innerText : pre.innerText;

          try {
            await navigator.clipboard.writeText(text);
            button.classList.add('copied');
            button.innerHTML = `
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>¡Copiado!</span>
            `;
            setTimeout(() => {
              button.classList.remove('copied');
              button.innerHTML = `
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                </svg>
                <span>Copiar</span>
              `;
            }, 2000);
          } catch (err) {
            console.error('Error al copiar código:', err);
          }
        });

        pre.appendChild(button);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupCodeCopyButtons);
    } else {
      setupCodeCopyButtons();
    }
  </script>
</body>
</html>
